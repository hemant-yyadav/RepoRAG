APP_NAME=Codebase RAG Assistant
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Future LLM configuration (not used in Phase 0)
GEMINI_API_KEY=
GEMINI_MODEL=
GENERATION_MAX_CONTEXT_CHARS=20000
GENERATION_MAX_CONTEXT_CHUNKS=12

# Future vector database configuration (not used in Phase 0)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=codebase_chunks

# Repository ingestion
MAX_FILE_SIZE_BYTES=1048576
GIT_CLONE_TIMEOUT_SECONDS=60

# Code-aware chunking (used by the future processing phase)
MAX_CHUNK_SIZE=4000
CHUNK_OVERLAP_LINES=2
MIN_CHUNK_SIZE=200

# Embeddings (vector storage is not configured in this phase)
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
EMBEDDING_INITIAL_BACKOFF_SECONDS=0.5

# Retrieval (development endpoint only; no answer generation)
RETRIEVAL_TOP_K=5
# RETRIEVAL_SCORE_THRESHOLD=0.25
RETRIEVAL_CANDIDATE_POOL_SIZE=20
RETRIEVAL_RRF_K=60
RETRIEVAL_VECTOR_WEIGHT=1.0
RETRIEVAL_BM25_WEIGHT=1.0

# Neural reranking (local cross-encoder model)
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_CANDIDATE_COUNT=20
RERANKER_FINAL_COUNT=5
RERANKER_BATCH_SIZE=16
RERANKER_FAIL_OPEN=true

NEXT_PUBLIC_API_URL=http://localhost:8000
